{
  "contextTier": "long_context",
  "enabledPlugins": {
    "azure@awesome-copilot": true,
    "azure-devops-copilot-plugin@copilot-plugins": true
  },
  "extraKnownMarketplaces": {
    "azure-devops-copilot-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "microsoft/azure-devops-copilot-plugin"
      }
    },
    "copilot-plugins": {
      "source": {
        "source": "github",
        "repo": "github/copilot-plugins"
      }
    }
  },
  "footer": {
    "showAgent": true,
    "showAiUsed": true,
    "showBranch": true,
    "showCodeChanges": false,
    "showContextWindow": true,
    "showCustom": false,
    "showDirectory": true,
    "showModelEffort": true,
    "showQuota": true,
    "showSandbox": true,
    "showUsername": false,
    "showYolo": true
  },
  "hooks": {
    "SessionStart": [
      {
        "bash": "bash '/home/kuba/.copilot/hooks/herdr-agent-state.sh'",
        "timeoutSec": 10,
        "type": "command"
      }
    ]
  },
  "model": "claude-sonnet-5",
  "planEffortLevel": "high",
  "planContextTier": "long_context",
  "planModel": "claude-opus-5.5",
  "theme": "auto"
}
